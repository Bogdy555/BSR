#include "..\Headers\BSR_APP_WIN_Resources.hpp"



#include "..\Headers\BSR_APP_WIN_WinTargetVer.hpp"
#include <Windows.h>



LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US



VS_VERSION_INFO VERSIONINFO
FILEVERSION BSR_APP_WIN_VERSION_LIST
PRODUCTVERSION BSR_APP_WIN_VERSION_LIST
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VERSION_INFO_FILE_FLAGS
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK L"StringFileInfo"
	BEGIN
		BLOCK L"040904B0"
		BEGIN
			VALUE L"CompanyName", BSR_APP_WIN_COMPANY_NAME
			VALUE L"FileDescription", BSR_APP_WIN_APP_NAME
			VALUE L"FileVersion", BSR_APP_WIN_VERSION_STRING
			VALUE L"InternalName", BSR_APP_WIN_FILE_NAME
			VALUE L"LegalCopyright", BSR_APP_WIN_COPY_RIGHT_EN_US
			VALUE L"LegalTrademarks", BSR_APP_WIN_COMPANY_NAME
			VALUE L"OriginalFilename", BSR_APP_WIN_FILE_NAME
			VALUE L"ProductName", BSR_APP_WIN_APP_NAME
			VALUE L"ProductVersion", BSR_APP_WIN_VERSION_STRING
		END
	END
	BLOCK L"VarFileInfo"
	BEGIN
		VALUE L"Translation" 0x0409, 0x04B0
	END
END
